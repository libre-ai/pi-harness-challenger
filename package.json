{
  "name": "pi-harness-challenger",
  "version": "0.1.0",
  "private": true,
  "description": "Additive, reversible experiments for a local Pi harness",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/policy-gate/index.mjs",
      "./extensions/handoff/index.mjs"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "setup:gondolin": "npm ci --ignore-scripts --prefix experiments/gondolin",
    "test": "node --test test/*.test.mjs",
    "test:transactional:coverage": "node --test --experimental-test-coverage --test-coverage-include=experiments/gondolin/release-manager.mjs --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=95 test/transactional-updater.test.mjs",
    "test:runtime-lifecycle:coverage": "node --test --experimental-test-coverage --test-coverage-include=experiments/gondolin/runtime-binding.mjs --test-coverage-include=experiments/gondolin/runtime-adoption.mjs --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=100 test/runtime-binding.test.mjs test/runtime-adoption.test.mjs",
    "smoke": "PI_OFFLINE=1 pi --no-extensions --no-skills --no-prompt-templates --no-themes --no-context-files -e ./extensions/policy-gate/index.mjs -e ./extensions/handoff/index.mjs --list-models __challenger_smoke__",
    "smoke:skills": "PI_OFFLINE=1 pi --no-extensions --no-skills --no-prompt-templates --no-themes --no-context-files --skill ./skills --list-models __challenger_skills_smoke__",
    "smoke:rpc": "node experiments/gondolin/deployed-rpc-e2e.mjs",
    "smoke:budgets": "node experiments/gondolin/budget-test.mjs",
    "deployment:status": "node experiments/gondolin/update-local.mjs status",
    "deployment:rollback": "node experiments/gondolin/update-local.mjs rollback",
    "transactional:install": "node experiments/gondolin/update-local.mjs install",
    "transactional:status": "node experiments/gondolin/update-local.mjs status",
    "transactional:update": "node experiments/gondolin/update-local.mjs update",
    "transactional:rollback": "node experiments/gondolin/update-local.mjs rollback",
    "transactional:automation:enable": "node experiments/gondolin/update-local.mjs automation-enable",
    "transactional:automation:disable": "node experiments/gondolin/update-local.mjs automation-disable",
    "eval:handoff": "node scripts/handoff-quality-eval.mjs",
    "eval:handoff:continuation": "node scripts/handoff-quality-eval.mjs --continuation",
    "eval:policy": "node scripts/policy-friction-eval.mjs",
    "eval:policy:safety": "node scripts/policy-safety-eval.mjs",
    "eval:policy:sandbox": "node scripts/policy-sandbox-friction-eval.mjs",
    "eval:sandbox": "node scripts/sandbox-preflight.mjs",
    "eval:sandbox:licenses": "node scripts/sandbox-license-audit.mjs",
    "eval:status": "node scripts/eval-status.mjs",
    "lint:comments": "node scripts/comment-hygiene.mjs",
    "check": "npm run lint:comments && npm run test && npm run test:transactional:coverage && npm run test:runtime-lifecycle:coverage && npm run smoke && npm run smoke:skills && npm run smoke:budgets && npm run smoke:rpc && npm run deployment:status"
  }
}
